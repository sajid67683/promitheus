# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables (never commit real values).

# PostgreSQL. On Vercel use your provider's *pooled* connection string (e.g. Neon "-pooler" host).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/promitheus_db

# Signs login tokens. Must be 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google AI Studio key: https://aistudio.google.com/
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# Comma-separated models tried when the main one is overloaded:
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Quick yes/no answer checks:
# GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Optional: enables "Continue with Google". Add your deployed URL to the
# OAuth client's "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Optional: password-reset emails via Resend (https://resend.com). Without these,
# "Forgot password?" is hidden. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Promitheus <no-reply@yourdomain.com>
# Public site URL used in emails, e.g. https://promitheus.vercel.app
APP_URL=

# Protects the weekly league reset cron endpoint. Vercel sends it automatically.
CRON_SECRET=

# "production" hides the /docs API explorer (automatic on Vercel production deployments).
ENVIRONMENT=development

# Optional limits
# MAX_UPLOAD_MB=4
# DAILY_UPLOAD_LIMIT=10
# DAILY_AI_GRADING_LIMIT=200
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
